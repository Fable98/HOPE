# Copy to .env and fill in. `npm start` reads .env automatically.

# Which model service plans the steps: anthropic, openai or mock.
# Leave empty to pick automatically: anthropic if ANTHROPIC_API_KEY is set,
# then openai if OPENAI_API_KEY is set, otherwise the rule-based mock.
HOPE_LLM_PROVIDER=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any service with an OpenAI-style chat completions API.
OPENAI_BASE_URL=https://api.openai.com/v1

# Override the default models (planner = main model, simplify = cheaper model).
HOPE_PLANNER_MODEL=
HOPE_SIMPLIFY_MODEL=

HOPE_HOST=127.0.0.1
HOPE_PORT=8787
# Base URL used in family help links. Set this when the server is public.
HOPE_PUBLIC_URL=http://localhost:8787

# Optional shared secret. When set, the extension must send the same value
# (Settings > Access code) in the x-hope-token header.
HOPE_CLIENT_TOKEN=

# Comma-separated origins allowed to call the API, for example
# chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Empty means any Chrome extension.
HOPE_ALLOWED_ORIGINS=

HOPE_RATE_LIMIT_PER_MINUTE=120

# Serve the practice site at /demo/. Set to false on a public server.
HOPE_SERVE_DEMO=true
